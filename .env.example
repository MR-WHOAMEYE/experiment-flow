# ============================================================
# EaaS Platform — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eaas
POSTGRES_USER=eaas_user
POSTGRES_PASSWORD=change_me

# Constructed from the above; can be overridden directly.
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://eaas_user:change_me@localhost:5432/eaas

# --- MySQL (optional connector) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=source_db
MYSQL_USER=mysql_user
MYSQL_PASSWORD=change_me

# --- n8n (self-hosted Docker) ---
N8N_HOST=http://localhost:5678
N8N_API_KEY=change_me

# --- File storage ---
# Directory where serialized ML models are saved
MODEL_DIR=models/

# --- Encryption (for connector credentials) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me

# --- Logging ---
LOG_LEVEL=INFO
